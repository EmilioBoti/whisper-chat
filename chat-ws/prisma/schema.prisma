generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  ADMIN
  MEMBER
}

enum MessageStatus {
  PENDING
  SENT
  RECEIVED
  READ
}

enum MessageType {
  TEXT
}

enum FriendShipStatus {
  PENDING
  ACCAPTED
  REJECTED
}

model Chat {
  id        String @id @default(uuid())
  type      ChatType
  createdBy String
  createdAt DateTime @default(now())
  directKey String? @unique // created by both user's ids

  members   ChatMember[]
  messages  Message[]

}

model ChatMember {
  id           String @id @default(uuid())
  chatId       String
  userId       String
  role         ChatMemberRole @default(MEMBER)
  joinedAt     DateTime @default(now())

  chat         Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  profile      Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id           String @id @default(ulid())
  chatId       String
  senderId     String
  content      String
  status      MessageStatus @default(PENDING)
  type        MessageType @default(TEXT)
  createdAt    DateTime @default(now())
  
  chat         Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, senderId])
}

model Profile {
  id          String @id
  name        String
  lastname    String?
  birthDate   DateTime?
  photo       String?
  about       String?
  isPublic    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ChatMember[]
  settings    UserSettings[]
  friendshipsAsA       UserFriendShip[] @relation("FriendshipsAsA")
  friendshipsAsB       UserFriendShip[] @relation("FriendshipsAsB")
  sentNotifications   UserFriendNotification[] @relation("NotificationSender")
  receivedNotifications   UserFriendNotification[] @relation("NotificationReceiver")
}

model UserSettings {
  userId                String @id()

  // NOTIFICATIONS
  pushEnabled           Boolean @default(true)
  inAppSoundEnabled     Boolean @default(true)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model UserFriendNotification {
  id              Int @id @default(autoincrement())
  notiKey         String @unique // created by both user's ids
  senserId        String
  receiverId      String
  status          FriendShipStatus
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  sender Profile @relation("NotificationSender", fields: [senserId], references: [id], onDelete: Cascade)
  recuiver Profile @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senserId])
  @@index([receiverId])

}

model UserFriendShip {
  id              Int @id @default(autoincrement())
  friendsKey      String @unique // created by both user's ids
  userIdA         String
  userIdB         String
  senderId        String
  createdAt       DateTime @default(now())

  friendshipsAsA Profile @relation("FriendshipsAsA", fields: [userIdA], references: [id], onDelete: Cascade)
  friendshipsAsB Profile @relation("FriendshipsAsB", fields: [userIdB], references: [id], onDelete: Cascade)

  @@unique([userIdA, userIdB])
  @@index([userIdB])
}